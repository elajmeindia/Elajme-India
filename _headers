/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Permitted-Cross-Domain-Policies: none

# Cloudflare Pages manages static-asset caching and invalidates assets on deployment.
# Keep application assets on Pages defaults because current CSS/JS/image filenames
# are not content-hashed; long browser max-age values could otherwise serve stale files.

# The English doctor and hospital directory routes previously exposed stale legacy
# header markup at the custom domain. Force HTML revalidation on every request so
# Cloudflare/browser caches cannot retain an older directory document.
/hospitals/
  Cache-Control: no-cache, no-store, must-revalidate

/hospitals/*
  Cache-Control: no-cache, no-store, must-revalidate

/doctors/
  Cache-Control: no-cache, no-store, must-revalidate

/doctors/*
  Cache-Control: no-cache, no-store, must-revalidate

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

# Always revalidate the English enquiry handler when treatment context changes.
/script.js
  Cache-Control: no-cache, must-revalidate
